# Site URL — used for canonical URLs, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://scentlab.in

# WhatsApp number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=917569067363

# Brand name. Change this single value to rebrand the whole site.
NEXT_PUBLIC_BRAND_NAME=SCENT LAB

# City label used in copy and metadata.
NEXT_PUBLIC_CITY=Bengaluru

# Analytics stays off until a provider is wired up.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
